# Database (async PostgreSQL URL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tailored_resume

# JWT secret (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# OpenAI (for job analysis, resume generation, optional parser fallback)
OPENAI_API_KEY=sk-...

# Optional: debug
DEBUG=false

# Upload directory (relative to backend root)
UPLOAD_DIR=uploads

# Max upload size in bytes (default 4MB). Only PDF and DOCX allowed.
# MAX_UPLOAD_BYTES=4194304

# Minimum ATS score to save a generated resume (default 90; reject below this)
MIN_ATS_SCORE=90

# CORS origins (comma-separated). Default: http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=http://localhost:3000,https://myapp.com
